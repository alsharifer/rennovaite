# RennovAIte — environment variable template.
# Copy to `.env.local` (gitignored) and fill in real values. Never commit secrets.

# --- Core services --------------------------------------------------------
ANTHROPIC_API_KEY=              # server — Claude calls
REPLICATE_API_TOKEN=            # server — image generation
# Optional: edit/restyle model id for renders (default google/nano-banana)
# RENDER_MODEL=google/nano-banana

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=       # client + server
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # client
SUPABASE_SERVICE_ROLE_KEY=      # server only — never expose

# --- Analytics (optional; unset = no-op) ----------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Knowledge Graph (KG) retrieval --------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                 # dev default in the KG module: rennovaite_dev
# "true" turns on KG grounding (requires Neo4j running: cd kg && docker compose up -d)
KG_ENABLED=false

# --- BoQ engine (optional) ------------------------------------------------
# Default (unset) = deterministic lib/boq engine. Set "llm" for the legacy
# Claude-priced path.
# BOQ_ENGINE=llm

# --- Pilot Seven feature flags (reserved; wired by their owning prompts) ---
# Names are inferred by the pre-flight — each owning prompt should confirm.
# PLAN_ENABLED=false        # P1 — lib/plan (plan graph)
# DRAWINGS_ENABLED=false    # P2 — lib/drawings
# OVERLAYS_ENABLED=false    # P3 — lib/overlays (adds three / react-three)
# WHATIF_ENABLED=false      # P4 — lib/whatif (element_refs)
# PERMIT_CHECK_ENABLED=false # P6 — lib/compliance (Dubai permit triggers)
# STAGING_ENABLED=false      # P7 — lib/staging (furniture staging + optional BoQ section)

# --- Landing ---------------------------------------------------------------
# "true" makes `/` the Property OS intro page (visitors) and moves the existing
# RennovAIte homepage to `/rennovaite`. Read at server start — flip requires a
# dev-server restart. Unset/false = `/` is the RennovAIte homepage (as before).
# PROPERTY_OS_LANDING=false
