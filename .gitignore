# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Design references are local-only — except the R7 handoff, whose generated
# tokens.css the app imports (K1). j-series-inputs stays private.
/design-refs/*
!/design-refs/r7-handoff/
/.claude/worktrees

# ground-truth client documents (real contract/quotation data + PII) — the
# code-shaped source of truth lives in lib/ground-truth/, not the raw workbook.
/data/

# Bathroom pilot B2+: screenshots show the client's own photos — never in git (like data/).
/screenshots/bathroom-pilot/b2/
/screenshots/bathroom-pilot/b4/
/screenshots/bathroom-pilot/b5/
/screenshots/bathroom-pilot/b6/
